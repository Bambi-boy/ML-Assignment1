(function () {
    'use strict'
  // Only execute on the course users/people page
  if ((!/^\/courses\/\d+\/users/.test(window.location.pathname)) || !(ENV.SECTIONS.some(s => s.name === 'Seksjon for manuelt tillagte brukere'))) return;

  const CONFIG = {
    targetSectionName: "Seksjon for manuelt tillagte brukere"
  };

  const setComboboxValue = (mutations, observer) => {
    const sectionInput = document.querySelector('input[role="combobox"][aria-label*="Section"], input[role="combobox"][id*="section"]');
    if (sectionInput && !sectionInput.dataset.defaultSet) {

      observer.disconnect();
      sectionInput.focus();
      sectionInput.click();

      setTimeout(() => {
        const options = Array.from(document.querySelectorAll('[role="option"], [id*="option"]'));

        const match = options.find(opt => opt.textContent.trim() === CONFIG.targetSectionName);

        if (match) {
          match.click();

          sectionInput.dataset.defaultSet = "true";
        } else {
          sectionInput.blur();
        }

        observer.observe(document.body, { childList: true, subtree: true });
      }, 150);
    }
  };

  const observer = new MutationObserver(setComboboxValue);
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
})();