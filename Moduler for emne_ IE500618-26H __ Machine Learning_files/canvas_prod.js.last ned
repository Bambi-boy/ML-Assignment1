        async function uioGetEntireStructure (){
            //load all modules and items
            let modules = await Get (`courses/${ENV.COURSE_ID}/modules?include[]=items`)
            for (let module of modules){
                if (module.items?.length == 0)
                    module.items = await Get (`courses/${ENV.COURSE_ID}/modules/${module.id}/items`)
            }
