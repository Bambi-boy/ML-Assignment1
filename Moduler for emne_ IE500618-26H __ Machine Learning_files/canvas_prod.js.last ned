        function ModuleLabel(position){
            return position
        }

        function getCurrentPosition(modules){
            // console.log("modul index 0",modules[0])
            let itemid = false, possibleItemid = false, possibleModule = false, itemidUnsafe = false
            // console.log("menu=off?",location.search.indexOf('menu=off'))
            // if (location.search.indexOf('menu=off') !=-1) {return false}
            let pathname = (location.search.indexOf('useURL=')==-1)?location.pathname:/useURL=([^&?]*)/.exec(location.search)[1]
            let match = /courses\/\d+\/modules\/items\/(\d+)$/.exec(pathname);
            // console.log("match:",match)
            if (match) {itemid = match[1]}
            else {
                match = /module_item_id=(\d+)/.exec(location.search);
                // console.log("match (else)",match)
                if (match){
                    itemid = match[1]
                    itemidUnsafe = true //a link from another page can have wrong module_item_id and still show the correct page
                }
            }
            for (const module of modules){
                for (const item of module.items){
                    if (itemid && !itemidUnsafe && item.id == itemid) return {module:module.position, item:item.id}
                    match = /\/courses.*/.exec(item.url)
                    if (match && match[0] == pathname){
                        //When the path match we have found the correct page, but a page can be linked more than one place, so also check itemid
                        if (!itemid || item.id == itemid) return {module:module.position, item:item.id}
                        else {
                            //We have a matching page, but the unsafe moduleid doesn't match
                            possibleModule = module.position
                            possibleItemid = item.id
                        }
                    }
                }
            }
            if (possibleItemid) return {module:possibleModule, item:possibleItemid}
            return false
        }

        function uioMakeModuleMenu (modules,moduleposition){
            let html = '<div class="modulemenu">'
            for (const module of modules){
                let unpublished = (module.published == false)?' unpublished':''
                let active = (module.position == moduleposition)?' active':''
            html += `<div class="modulebutton module${module.position}${unpublished}${active} ${module.state}" data-module="${module.position}">${ModuleLabel(module.position)}</div>`
        }
            return html + '</div>'
        }

        function uioMakeItemMenu (module,itemId){
            function makeItemSymbol(itemtype){
                switch(itemtype){
                    case 'Page': return '<i class="icon-document"></i>'
                    case 'ExternalUrl':
                    case 'ExternalTool': return '<i class="icon-link"></i>'
                    case 'Discussion': return '<i class="icon-discussion"></i>'
                    case 'File': return '<i class="icon-paperclip"></i>'
                    case 'Quiz': return '<i class="icon-quiz icon-Solid"></i>'
                    case 'Assignment': return '<i class="icon-assignment"></i>'
                    default: return ''
                }
            }
            let items = module.items
            //Make the items menu for the module
            // console.log (module)



            let itemsymbol = ''
            let completesymbol = ''
            let html = '<ul>'
            for (let index=0; index<items.length; index++){
                if (items[index].type == 'SubHeader'){
                    html += `<li class="header indent${items[index].indent}"><span class="content">${items[index].title}</span></li>`
                    continue
                }
                html += `<li class="${items[index].type} indent${items[index].indent}`
                if (items[index].id == itemId) html += ' active'
                if (typeof items[index].completion_requirement !== 'undefined'){
                    if (items[index].completion_requirement.completed) html += ' complete'
                    else html += ' incomplete'
                }else{
                    html += ' optional'
                }
                if (!items[index].published) html += ' unpublished'
                html += '">'
                if (uio_menuconfig?.itemsymbols){
                    itemsymbol = makeItemSymbol(items[index].type)
                }
                if (items[index].id == itemId) html += `<span class="content">${itemsymbol}${items[index].title}</span>`
                else html += `<a href="${items[index].html_url}"><div class="content">${itemsymbol}${items[index].title}</div></a>`
                html += '</li>'
            }
            html += '</ul>'

            return `<div class="itemmenu module${module.position}"><div class="modulename">${module.name}</div>${html}</div>`
        }

