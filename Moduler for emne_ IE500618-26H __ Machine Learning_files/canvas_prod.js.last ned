function getNextUrl(linkHeader) {
  if (!linkHeader) return null;                 // no Link header at all
  // The header can contain several comma‑separated links:
  // <https://...>; rel="next", <https://...>; rel="prev"
  const links = linkHeader.split(',').map(part => part.trim());

  for (const link of links) {
    const match = link.match(/^<([^>]+)>;\s*rel="([^"]+)"$/);
    if (match && match[2] === 'next') {
      return match[1];                          // the URL we need
    }
  }
  return null;                                  // no “next” link found
}


async function fetchAllManageableAccounts(u) {
  const allAccounts = [];
  let url = u;
  let nextUrl = null;      // will hold the URL for the next page

  do {
    // ---- make the request -------------------------------------------------
    const response = await fetch(url);

    if (!response.ok) {
      throw new Error(`HTTP ${response.status} - ${response.statusText}`);
    }

    const pageData = await response.json();  // assuming JSON array/object
    allAccounts.push(...pageData);

    const linkHeader = response.headers.get('link'); // note: lowercase key works too
    nextUrl = getNextUrl(linkHeader);

    url = nextUrl;
  } while (nextUrl !== null);   // keep looping while a next link exists

  return allAccounts;
}


